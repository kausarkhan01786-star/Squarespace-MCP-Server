# Squarespace Commerce API key. Grant only read-only Products, Inventory,
# Orders, and Discounts permissions for the commerce tools in this release.
# Never commit real credentials.
SQUARESPACE_API_KEY=6da15d30-7574-4267-b52c-61f9649faabd

# Required to target commerce API calls: the Squarespace siteId returned by
# GET /1.0/authorization/website for the API key above.
SQUARESPACE_SITE_ID=cobalt-spinach-eeah

# Application logging level: trace, debug, info, warn, or error.
LOG_LEVEL=info

# Optional absolute path for the local persistent Chromium profile.
# Keep it outside the project directory; the default is an OS user data folder.
SQUARESPACE_BROWSER_PROFILE_DIR=
