# Squarespace API key for supported API operations. Never commit real credentials.
SQUARESPACE_API_KEY=

# Optional site identifier for installations managing multiple sites.
SQUARESPACE_SITE_ID=

# Application logging level: trace, debug, info, warn, or error.
LOG_LEVEL=info

# Optional absolute path for the local persistent Chromium profile.
# Keep it outside the project directory; the default is an OS user data folder.
SQUARESPACE_BROWSER_PROFILE_DIR=
